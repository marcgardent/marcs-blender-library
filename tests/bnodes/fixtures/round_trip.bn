geometry graph "Smooth Mesh"(Mesh: Geometry, Level: Int) -> Geometry {
  return Mesh |> SubdivideMesh(Level)
    |> SetShadeSmooth()
}

geometry graph scatter(geometry: Geometry, "Point Count": Int) -> (Geometry: Geometry, Count: Int) {
  grid = MeshGrid(2.0, 2.0, point_count, point_count)
  smooth = smooth_mesh(grid.mesh, 2)
  return (
    Geometry: geometry + SetPosition(smooth, offset: (0.0, 0.0, 0.5)) + SetMaterial(smooth, material: "Rust"),
    Count: point_count)
}
