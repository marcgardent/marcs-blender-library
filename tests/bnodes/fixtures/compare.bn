geometry graph mask(
    geometry: Geometry,
    t: Float,
    limit: Int,
    center: Vector,
    label: String
) -> Geometry {
  p = Position()
  high = p.z > t
  near = distance(p, center) <= 0.5
  return geometry |> SetPosition(high != near, offset: CombineXYZ(z: t))
    |> SetPosition(Index() == limit, center)
    |> SetPosition(label == "top", offset: (0.0, 0.0, 1.0))
    |> SetPosition(p == center)
    |> SetPosition(high and not near or (high xor label == "top"))
    |> SetPosition(Compare(t, 1.0, 0.1, operation: EQUAL))
    |> SetPosition(Compare(p, center, operation: LESS_THAN, data_type: VECTOR, mode: LENGTH))
}
