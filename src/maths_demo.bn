// Les démos de la boîte à outils : à construire avec maths.bn, qui définit les fonctions.

// La courbe y = f(x) pour x de 0 à 1, dans un cadre de 1 × 1 placé à la colonne et à la rangée
geometry graph tracé(y: Float, colonne: Float, rangée: Float) -> Geometry {
  coin = CombineXYZ(colonne * 1.4, -(rangée * 1.6))
  courbe = MeshLine(400, offset: (0.002506, 0.0, 0.0)) |> SetPosition(offset: coin + CombineXYZ(y: y))
    |> MeshToCurve()
    |> CurveToMesh(CurvePrimitiveCircle(radius: 0.012))
    |> SetMaterial(material: "Courbe")
  cadre = CurvePrimitiveQuadrilateral(1.0, 1.0) |> CurveToMesh(CurvePrimitiveCircle(radius: 0.004))
    |> Transform(translation: coin + (0.5, 0.5, 0.0))
    |> SetMaterial(material: "Cadre")
  return courbe + cadre
}

geometry graph "démo courbes"() -> Geometry {
  x = Position().x
  "Courbes" #e07030 {
    ligne_1 = tracé(biais(x, 0.25), 0.0, 0.0) + tracé(gain(x, 0.25), 1.0, 0.0) + tracé(accélère(x, 3.0), 2.0, 0.0) + tracé(freine(x, 3.0), 3.0, 0.0)
    ligne_2 = tracé(accélère_freine(x, 3.0), 0.0, 1.0) + tracé(impulsion(x, 6.0), 1.0, 1.0) + tracé(bosse(x, 0.5, 0.3), 2.0, 1.0) + tracé(parabole(x, 2.0), 3.0, 1.0)
    ligne_3 = tracé(rebond(x), 0.0, 2.0) + tracé(élastique(x), 1.0, 2.0) + tracé(recul(x), 2.0, 2.0) + tracé(marches(x * 4.0, 0.3) / 4.0, 3.0, 2.0)
  }
  "Ondes" #steelblue {
    ligne_4 = tracé(triangle(x * 2.0), 0.0, 3.0) + tracé(créneau(x * 2.0, 0.3), 1.0, 3.0) + tracé(sinus01(x * 2.0), 2.0, 3.0)
  }
  return ligne_1 + ligne_2 + ligne_3 + ligne_4
}

// La surface d'un SDF, maillée dans un cube de 2.6 de côté autour du centre
geometry graph surface(distance: Float, centre: Vector) -> Geometry {
  // Un fond négatif : sinon le bord du cube devient lui aussi une surface
  volume = VolumeCube(
    -distance,
    -1.0,
    min: centre - 1.3,
    max: centre + 1.3,
    resolution_x: 96,
    resolution_y: 96,
    resolution_z: 96)
  return VolumeToMesh(volume, threshold: 0.0) |> SetShadeSmooth()
}

geometry graph "démo sdf"() -> Geometry {
  p = Position()
  "Formes" #slategray {
    sphère = surface(sdf_sphère(p, 1.0), (0.0, 0.0, 0.0))
    // Une boîte aux arêtes arrondies : sa distance moins le rayon de l'arrondi
    boîte = surface(sdf_boîte(p - (2.8, 0.0, 0.0), (0.75, 0.75, 0.75)) - 0.15, (2.8, 0.0, 0.0))
    tore = surface(sdf_tore(p - (5.6, 0.0, 0.0), 0.85, 0.3), (5.6, 0.0, 0.0))
    cylindre = surface(sdf_cylindre(p - (8.4, 0.0, 0.0), 0.8, 0.9), (8.4, 0.0, 0.0))
  }
  "Opérations" #peru {
    q = p - (0.0, -3.6, 0.0)
    capsule = surface(sdf_capsule(q, (-0.6, 0.0, -0.6), (0.6, 0.0, 0.6), 0.4), (0.0, -3.6, 0.0))
    r = p - (2.8, -3.6, 0.0)
    creusée = surface(
      soustraction_douce(sdf_boîte(r, (0.85, 0.85, 0.85)), sdf_sphère(r - (0.0, -0.5, 0.5), 0.9), 0.2),
      (2.8, -3.6, 0.0))
    // Une coque de sphère ouverte en haut : un bol
    s = p - (5.6, -3.6, 0.0)
    bol = surface(max(coque(sdf_sphère(s, 1.0), 0.12), s.z - 0.3), (5.6, -3.6, 0.0))
    // Des billes répétées, gardées dans une boîte
    t = p - (8.4, -3.6, 0.0)
    billes = surface(
      max(sdf_sphère(répétition(t, 0.6), 0.22), sdf_boîte(t, (0.95, 0.95, 0.95))),
      (8.4, -3.6, 0.0))
  }
  "Nouvelles formes" #cadetblue {
    u = p - (0.0, -7.2, 0.0)
    cône = surface(sdf_cône(u, 0.9, 0.9, 0.25), (0.0, -7.2, 0.0))
    ellipsoïde = surface(sdf_ellipsoïde(p - (2.8, -7.2, 0.0), (1.15, 0.75, 0.55)), (2.8, -7.2, 0.0))
    octaèdre = surface(sdf_octaèdre(p - (5.6, -7.2, 0.0), 1.15), (5.6, -7.2, 0.0))
    // Une colonne carrée tordue sur sa hauteur
    tordue = surface(
      sdf_boîte(torsion(p - (8.4, -7.2, 0.0), 0.7), (0.5, 0.5, 1.0)) - 0.05,
      (8.4, -7.2, 0.0))
  }
  return sphère + boîte + tore + cylindre + capsule + creusée + bol + billes + cône + ellipsoïde + octaèdre + tordue
}

// Des montagnes : une grille relevée par un bruit fractal en crêtes
geometry graph "démo bruits"() -> Geometry {
  hauteur = fbm_crêtes(Position() * 0.2, 6) * 2.2
  return MeshGrid(8.0, 8.0, 240, 240) |> SetPosition(offset: CombineXYZ(z: hauteur))
    |> SetShadeSmooth()
    |> SetMaterial(material: "Montagne")
}
